{
  "id": "system-panel",
  "name": "System",
  "rows": [
    [
      { "media": "volumeDown" },
      { "media": "volumeUp" },
      { "media": "mute" },
      { "media": "brightnessDown" },
      { "media": "brightnessUp" }
    ],
    [
      { "media": "previous" },
      { "media": "playPause" },
      { "media": "next" },
      { "label": "Lock Screen", "image": "lock.fill", "macro": { "steps": [ { "shortcut": "ctrl+cmd+q" } ] } },
      { "label": "Screenshot", "image": "camera.viewfinder", "macro": { "steps": [ { "shortcut": "cmd+shift+4" } ] } }
    ]
  ]
}
