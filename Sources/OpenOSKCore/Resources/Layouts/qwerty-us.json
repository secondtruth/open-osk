{
  "id": "qwerty-us",
  "name": "English (QWERTY US)",
  "rows": [
    [
      { "special": "escape" },
      { "base": "`", "shift": "~" },
      { "base": "1", "shift": "!" },
      { "base": "2", "shift": "@" },
      { "base": "3", "shift": "#" },
      { "base": "4", "shift": "$" },
      { "base": "5", "shift": "%" },
      { "base": "6", "shift": "^" },
      { "base": "7", "shift": "&" },
      { "base": "8", "shift": "*" },
      { "base": "9", "shift": "(" },
      { "base": "0", "shift": ")" },
      { "base": "-", "shift": "_" },
      { "base": "=", "shift": "+" },
      { "special": "delete", "width": 1.5 }
    ],
    [
      { "special": "tab", "width": 1.5 },
      { "base": "q" },
      { "base": "w" },
      { "base": "e" },
      { "base": "r" },
      { "base": "t" },
      { "base": "y" },
      { "base": "u" },
      { "base": "i" },
      { "base": "o" },
      { "base": "p" },
      { "base": "[", "shift": "{" },
      { "base": "]", "shift": "}" },
      { "base": "\\", "shift": "|", "width": 1.5 }
    ],
    [
      { "special": "home", "width": 1.75 },
      { "base": "a" },
      { "base": "s" },
      { "base": "d" },
      { "base": "f" },
      { "base": "g" },
      { "base": "h" },
      { "base": "j" },
      { "base": "k" },
      { "base": "l" },
      { "base": ";", "shift": ":" },
      { "base": "'", "shift": "\"" },
      { "special": "return", "width": 2.25 }
    ],
    [
      { "modifier": "shift", "width": 2.25 },
      { "base": "z" },
      { "base": "x" },
      { "base": "c" },
      { "base": "v" },
      { "base": "b" },
      { "base": "n" },
      { "base": "m" },
      { "base": ",", "shift": "<" },
      { "base": ".", "shift": ">" },
      { "base": "/", "shift": "?" },
      { "modifier": "shift", "width": 2.25 }
    ],
    [
      { "modifier": "control", "width": 1.25 },
      { "modifier": "option", "width": 1.25 },
      { "modifier": "command", "width": 1.25 },
      { "special": "space", "width": 5.75 },
      { "modifier": "command", "width": 1.25 },
      { "special": "left" },
      { "special": "up" },
      { "special": "down" },
      { "special": "right" }
    ]
  ]
}
